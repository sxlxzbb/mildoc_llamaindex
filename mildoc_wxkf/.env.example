# mildoc wxkf —— RAG 问答服务（Flask + SSE）
# 复制为 .env 后填写实际值；以下值为示例，不含真实密钥/内网地址。

# ===== Flask =====
FLASK_DEBUG=True
FLASK_SECRET_KEY=replace_with_random_string
FLASK_HOST=0.0.0.0
FLASK_PORT=8872

# ===== MySQL（用户表 users）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mildoc

# ===== MinIO（文档来源）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc-cengci
MINIO_BUCKET_HIER=mildoc-hier
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# ===== Milvus（向量检索）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=change_me
MILVUS_DATABASE=mildoc_llamaindex
MILVUS_COLLECTION=mildoc_collection_llamaindex
MILVUS_INDEX_NAME=mildoc_index_llamaindex
MILVUS_COLLECTION_HIER=mildoc_collection_hier
MILVUS_INDEX_NAME_HIER=mildoc_index_hier
MILVUS_VECTOR_DIM=1024

# ===== Milvus 索引 / 检索调优（均有代码内默认值，不配也能跑）=====
# index_type / nlist / metric_type 属「建索引时」参数，仅集合首次创建时生效；
#   nprobe 属「查询时」参数，立即生效。
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_NLIST=100
MILVUS_METRIC_TYPE=COSINE
MILVUS_NPROBE=30

# ===== LLM（生成回答）=====
LLM_MODEL_NAME=qwen-max
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEMPERATURE=0.1
MAX_TOKENS=10000

# ===== Embedding =====
LLM_EMBEDDING_API_KEY=replace_with_your_key
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL_NAME=text-embedding-v4

# ===== 重排序（Rerank）=====
RERANK_PROVIDER=dashscope
RERANK_API_KEY=replace_with_your_key
RERANK_MODEL_NAME=gte-rerank-v2
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ===== Redis（短期记忆）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=1800

# ===== 记忆 =====
# 多轮对话保留的最大轮数（喂给压缩提示词的历史条数）
MEMORY_MAX_TURNS=20

# ===== 检索方式 A/B 对比 =====
# 默认 default（原混合检索）。取消下一行注释即切换到 AutoMergingRetriever。
# 集合/命名空间必须与 mildoc_index 摄取侧写入层级节点时完全一致。
# RETRIEVER_MODE=hierarchical
# MILVUS_COLLECTION_HIERARCHICAL=mildoc_collection_cengci_hier
REDIS_INDEX_NAME_SPACE_HIER=redis_index_hier
REDIS_DOC_NAME_SPACE_HIER=redis_docs_hier
