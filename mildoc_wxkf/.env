# mildoc wxkf (RAG 问答服务)

# Flask
FLASK_DEBUG=True
FLASK_SECRET_KEY=tXTCjeWx50yqcUERo6x1qCU
FLASK_HOST=0.0.0.0
FLASK_PORT=8872

# MySQL（用户表 users）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=mildoc

# MinIO（文档来源，后续检索使用）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc-cengci
MINIO_BUCKET_HIER=mildoc-hier
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# Milvus（向量检索，后续检索模块使用）
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=admin123
MILVUS_DATABASE=mildoc_llamaindex
MILVUS_COLLECTION=mildoc_collection_llamaindex
MILVUS_INDEX_NAME=mildoc_index_llamaindex
MILVUS_COLLECTION_HIER=mildoc_collection_hier
MILVUS_INDEX_NAME_HIER=mildoc_index_hier
MILVUS_VECTOR_DIM=1024

# LLM（生成回答）
LLM_MODEL_NAME=qwen3.7-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEMPERATURE=0.1
MAX_TOKENS=10000

# Embedding
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL_NAME=text-embedding-v4

# 重排序
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_MODEL_NAME=gte-rerank-v2
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# Redis（短期记忆）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=1800

# 记忆
MEMORY_MAX_TURNS=20

# ===== 检索方式 A/B 对比 =====
# 默认 RETRIEVER_MODE=default（原混合检索）。取消下一行注释即切换到 AutoMergingRetriever。
# 下面集合/命名空间必须与 mildoc_index 摄取侧写入层级节点时完全一致（否则无法定位父节点）。
RETRIEVER_MODE=hierarchical
#MILVUS_COLLECTION_HIERARCHICAL=mildoc_collection_cengci_hier
REDIS_INDEX_NAME_SPACE_HIER=redis_index_hier
REDIS_DOC_NAME_SPACE_HIER=redis_docs_hier
