# mildoc index

# minio
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc-llamaindex
MINIO_BUCKET_HIER=mildoc-hier
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# 监听 MinIO 桶事件后，并行处理文档（解析+embedding+写 Milvus）的线程池大小
# 默认取 CPU 核数；解析偏 CPU，建议别设太大，按机器核数从 2~4 起步调优
# MINIO_PROCESS_MAX_WORKERS=4

# milvus
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=admin123
MILVUS_DATABASE=mildoc_llamaindex
MILVUS_COLLECTION=mildoc_collection_llamaindex
MILVUS_INDEX_NAME=mildoc_index_llamaindex
MILVUS_COLLECTION_HIER=mildoc_collection_hier
MILVUS_INDEX_NAME_HIER=mildoc_index_hier
MILVUS_VECTOR_DIM=1024

# ===== Milvus 索引 / 检索调优参数 =====
# 以下四项均有代码内默认值（见 config.py），不配也能跑（等价于当前行为）。
# 注意：index_type / nlist / metric_type 属「建索引时」参数，仅集合首次创建时生效；
#   若集合已存在，改了不会重建，需删集合重摄取。nprobe 属「查询时」参数，立即生效。
# 索引类型：FLAT(精确,默认) / IVF_FLAT / IVF_SQ8 / IVF_PQ ...
# 推荐：数据量较大时改用 IVF_FLAT，并配合下面 NLIST。
MILVUS_INDEX_TYPE=IVF_FLAT
# IVF 聚簇数（仅 IVF_* 系列生效）。经验：nlist ≈ sqrt(N) ~ 4*sqrt(N)，N=向量总数。
MILVUS_NLIST=100
# 相似度度量：IP(默认,当前行为) / L2 / COSINE。
# 推荐：embedding 用 text-embedding-v4 时改用 COSINE（语义相似度更贴合）。
MILVUS_METRIC_TYPE=COSINE
# 查询时扫描的聚簇数（仅 IVF_* 生效）：nprobe 越大召回越高越慢。
# 经验：nprobe ≈ nlist/10 起步。 该参数仅在检索侧使用，摄取侧可以没有
MILVUS_NPROBE=10

LLM_MODEL_NAME=qwen3.7-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# bailian embedding llm
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENBEDDING_MODEL=text-embedding-v4


# MinerU
# 启用MinerU前，先安装： uv add mineru[core]==2.7.0
# MINERU_SERVER_URL=http://127.0.0.1:8000

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=mildoc-images
# 文件里的图片上传OSS后的存放路径
OSS_IMAGE_PATH=doc_image
# 解析文件的时候，图片在本地存放的文件夹名称
DOC_IMAGE_DIR=images
# 是否将文档中的图片上传OSS
UPLOAD_IMAGE_TO_OSS=false

TMP_FILE_DIR=D:\zbb\test\temp
USE_MINREU=false
USE_PYMUPDF4LLM=true
USE_LIBRE_OFFICE=true

#这个配置是告诉minerU让去哪儿下载PDF-Extract-Kit-1.0
MINERU_MODEL_SOURCE=modelscope

SOFFICE_PATH='D:\Program Files\LibreOffice\program\soffice.exe'

CHUNK_SIZE=800
OVERLAP_SIZE=200
TITLE_EXTRACTOR_NODES=5

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_INDEX_NAME_SPACE=redis_index
REDIS_DOC_NAME_SPACE=redis_docs
REDIS_CACHE=redis_cache
REDIS_INDEX_NAME_SPACE_HIER=redis_index_hier
REDIS_DOC_NAME_SPACE_HIER=redis_docs_hier
REDIS_CACHE_HIER=redis_cache_hier

# ===== 节点解析方式 A/B 对比 =====
# 默认 NODE_PARSER_MODE=default（原逻辑）。取消下一行注释即切换到层次节点解析器。
# 下面 HIERARCHICAL_* 已预填独立集合/命名空间，确保切换后不会覆盖默认方式的数据。
NODE_PARSER_MODE=hierarchical
# HIERARCHICAL_CHUNK_SIZES=2048,512
#HIERARCHICAL_COLLECTION=mildoc_collection_cengci_hier
#HIERARCHICAL_REDIS_DOC_NS=redis_docs_hier
#HIERARCHICAL_REDIS_INDEX_NS=redis_index_hier
#HIERARCHICAL_REDIS_CACHE=redis_cache_hier

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=mildoc

