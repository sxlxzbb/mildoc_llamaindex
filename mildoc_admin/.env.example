# mildoc admin —— 文档管理后台（Flask Web）
# 复制为 .env 后填写实际值；以下值为示例，不含真实密钥。

# ===== MinIO（文档对象存储）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc-llamaindex
MINIO_BUCKET_HIER=mildoc-hier
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false
# mildoc_index 解析文档的模式：default / hierarchical
NODE_PARSER_MODE=hierarchical

# ===== Milvus（向量库）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=change_me
MILVUS_DATABASE=mildoc_llamaindex
MILVUS_COLLECTION=mildoc_collection_llamaindex
MILVUS_INDEX_NAME=mildoc_index_llamaindex
MILVUS_COLLECTION_HIER=mildoc_collection_hier
MILVUS_INDEX_NAME_HIER=mildoc_index_hier
MILVUS_VECTOR_DIM=1024

# ===== 管理后台登录 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ===== Flask =====
FLASK_DEBUG=true
FLASK_SECRET_KEY=replace_with_random_string
FLASK_HOST=0.0.0.0
FLASK_PORT=8871
