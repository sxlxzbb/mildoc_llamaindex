# mildoc index —— 文档摄取 / 向量化服务（MinIO 事件 -> 解析 + embedding + 写 Milvus）
# 复制为 .env 后填写实际值；以下值为示例，不含真实密钥/内网地址。

# ===== MinIO（文档来源）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc-llamaindex
MINIO_BUCKET_HIER=mildoc-hier
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# 监听 MinIO 桶事件后并行处理文档的线程池大小；默认取 CPU 核数，建议 2~4 起步
# MINIO_PROCESS_MAX_WORKERS=4

# ===== Milvus（向量库）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=change_me
MILVUS_DATABASE=mildoc_llamaindex
MILVUS_COLLECTION=mildoc_collection_llamaindex
MILVUS_INDEX_NAME=mildoc_index_llamaindex
MILVUS_COLLECTION_HIER=mildoc_collection_hier
MILVUS_INDEX_NAME_HIER=mildoc_index_hier
MILVUS_VECTOR_DIM=1024

# ===== Milvus 索引 / 检索调优（均有代码内默认值，不配也能跑）=====
# index_type / nlist / metric_type 属「建索引时」参数，仅集合首次创建时生效；
#   集合已存在则改了不重建，需删集合重摄取。nprobe 属「查询时」参数，立即生效。
# 索引类型：FLAT(精确,默认) / IVF_FLAT / IVF_SQ8 / IVF_PQ ...
MILVUS_INDEX_TYPE=IVF_FLAT
# IVF 聚簇数（仅 IVF_* 生效），经验 nlist ≈ sqrt(N) ~ 4*sqrt(N)
MILVUS_NLIST=100
# 相似度度量：IP(默认) / L2 / COSINE。embedding 用 text-embedding-v4 时推荐 COSINE
MILVUS_METRIC_TYPE=COSINE
# 查询时扫描聚簇数（仅 IVF_* 生效），经验 nprobe ≈ nlist/10 起步
MILVUS_NPROBE=10

# ===== LLM（解析阶段的 TitleExtractor 等使用）=====
LLM_MODEL_NAME=qwen-plus
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding =====
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENBEDDING_MODEL=text-embedding-v4

# ===== MinerU（可选，PDF 解析增强）=====
# 启用前先安装： uv add mineru[core]==2.7.0
# MINERU_SERVER_URL=http://127.0.0.1:8000

# ===== 阿里云 OSS（文档图片存储，可选）=====
OSS_ACCESS_KEY_ID=replace_with_your_key
OSS_ACCESS_KEY_SECRET=replace_with_your_secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=mildoc-images
# 图片上传 OSS 后的存放路径
OSS_IMAGE_PATH=doc_image
# 解析时图片在本地存放的文件夹名称
DOC_IMAGE_DIR=images
# 是否将文档中的图片上传 OSS
UPLOAD_IMAGE_TO_OSS=false

# ===== 解析器本地配置 =====
TMP_FILE_DIR=./tmp
USE_MINREU=false
USE_PYMUPDF4LLM=true
USE_LIBRE_OFFICE=true
# 告诉 MinerU 去哪儿下载模型（modelscope / huggingface）
MINERU_MODEL_SOURCE=modelscope
# LibreOffice 可执行文件路径（用于 Office 文档转 PDF）
SOFFICE_PATH=/usr/bin/soffice

# ===== 切片参数 =====
CHUNK_SIZE=800
OVERLAP_SIZE=200
TITLE_EXTRACTOR_NODES=5

# ===== Redis（docstore / index store / cache）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INDEX_NAME_SPACE=redis_index
REDIS_DOC_NAME_SPACE=redis_docs
REDIS_CACHE=redis_cache
REDIS_INDEX_NAME_SPACE_HIER=redis_index_hier
REDIS_DOC_NAME_SPACE_HIER=redis_docs_hier
REDIS_CACHE_HIER=redis_cache_hier

# ===== 节点解析方式 A/B 对比 =====
# 默认 default；取消下一行注释即切换到层次节点解析器（对应独立集合/命名空间）。
# NODE_PARSER_MODE=hierarchical
# HIERARCHICAL_CHUNK_SIZES=2048,512
# HIERARCHICAL_COLLECTION=mildoc_collection_cengci_hier
# HIERARCHICAL_REDIS_DOC_NS=redis_docs_hier
# HIERARCHICAL_REDIS_INDEX_NS=redis_index_hier
# HIERARCHICAL_REDIS_CACHE=redis_cache_hier

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mildoc
